<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/machinist_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="جعبه‌ابزار ماشین‌کار"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_training"
            style="@style/MachinistWidgetButton"
            android:text="🎓  آموزش CNC" />

        <TextView
            android:id="@+id/widget_calculator"
            style="@style/MachinistWidgetButton"
            android:text="📐  ماشین‌حساب" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_terms"
            style="@style/MachinistWidgetButton"
            android:text="📚  اصطلاحات" />

        <TextView
            android:id="@+id/widget_notes"
            style="@style/MachinistWidgetButton"
            android:text="📝  یادداشت" />
    </LinearLayout>
</LinearLayout>

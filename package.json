{
  "name": "machinist-toolbox",
  "version": "1.0.0",
  "description": "Machinist Toolbox Android App",
  "main": "index.js",
  "scripts": {
    "build": "echo 'Web files are already in www folder'",
    "sync": "npx cap sync android && powershell -ExecutionPolicy Bypass -File android\\restore-game-after-sync.ps1",
    "open:android": "npx cap open android",
    "preview": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const mime={'.html':'text/html','.js':'application/javascript','.css':'text/css','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml','.json':'application/json','.webmanifest':'application/manifest+json'};const s=http.createServer((req,res)=>{let u=req.url.split('?')[0];if(u==='/')u='/android-preview.html';let p=path.join(__dirname,decodeURIComponent(u));if(fs.existsSync(p)&&fs.statSync(p).isFile()){res.writeHead(200,{'Content-Type':mime[path.extname(p)]||'application/octet-stream'});fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not found');}});s.listen(8080,()=>{console.log('Preview running at http://localhost:8080/android-preview.html');require('child_process').exec('start http://localhost:8080/android-preview.html');});\""
  },
  "dependencies": {
    "@capacitor/app": "^5.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0"
  }
}